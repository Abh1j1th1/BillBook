# BillBook configuration
# Copy this file to ".env" and edit the values. Never commit your real .env.

# Reading mode the app starts in: "ollama" (local, private) or "gemini" (cloud).
# You can still switch modes from the Scan tab.
BILLBOOK_BACKEND=ollama

# ---------- Local mode (Ollama) ----------
# Must match a model shown by `ollama list`.
BILLBOOK_MODEL=gemma4:12b
# Context window for Ollama requests.
BILLBOOK_NUM_CTX=8192

# ---------- Cloud mode (Gemini API) ----------
# Get a key at https://aistudio.google.com/apikey
# Leave blank if you prefer to paste the key in the app (it is never saved to disk).
GEMINI_API_KEY=
BILLBOOK_GEMINI_MODEL=gemma-4-26b-a4b-it

# ---------- Optional ----------
# Longest image side in pixels before sending to the model.
# Defaults: 1600 for local, 2000 for cloud. Uncomment to override.
# BILLBOOK_MAX_SIDE=1600
